# Base de datos SQLite (ruta absoluta o relativa al directorio backend)
DATABASE_URL=sqlite:///./pdv.db

# Seguridad
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
TOKEN_TTL_MINUTES=480
SSE_TOKEN_TTL_SECONDS=60

# Impresión simulada
PRINT_MODE=file
PRINT_DIR=./impresiones

# Operación
APP_TIMEZONE=America/Bogota
MESAS_TOTAL=46
AUTO_CREATE_DB=true
SQLITE_WAL=true
SQLITE_BUSY_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_TO_FILE=false

# CORS (separar por comas; * para desarrollo)
CORS_ORIGINS=*

# Frontend estático (opcional)
FRONTEND_DIR=../frontend
